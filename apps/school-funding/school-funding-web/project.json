{
  "name": "school-funding-web",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/school-funding/school-funding-web",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bunx next build",
        "cwd": "apps/school-funding/school-funding-web"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "bun run build",
          "bunx opennextjs-cloudflare build --skipNextBuild",
          "bunx opennextjs-cloudflare deploy"
        ],
        "parallel": false,
        "cwd": "apps/school-funding/school-funding-web"
      }
    }
  }
}
